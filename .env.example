# Copy to .env and fill in values. Never commit .env.

# ──────────────────────────────────────────────────────────────
# Database — Postgres. Works with both local and NeonDB.
# ──────────────────────────────────────────────────────────────
# Local Docker:    postgresql://postgres:dev@localhost:5432/traveloop
# Local native:    postgresql://archVaibhav@localhost:5432/traveloop
# NeonDB:          postgresql://USER:PASS@ep-xxx.region.neon.tech/traveloop?sslmode=require
DATABASE_URL="postgresql://postgres:dev@localhost:5432/traveloop"

# ──────────────────────────────────────────────────────────────
# NextAuth (Auth.js v5)
# ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ──────────────────────────────────────────────────────────────
# Optional — Google OAuth (post-MVP)
# https://console.cloud.google.com/apis/credentials
# ──────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ──────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────
NODE_ENV="development"
